---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "PARDUS — Natural Wine Project",
  description = "PARDUS is a natural wine project from the western slopes of a forgotten Aegean island. Low intervention, high altitude, single-vineyard.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://pardus.wine");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT,WONK@9..144,300..900,0..100,0..1&family=JetBrains+Mono:wght@400&family=Inter:wght@400&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Mark JS as available BEFORE first paint so animated elements stay hidden
      // until GSAP takes over. Without this they flash visible for a frame.
      document.documentElement.classList.add("js");
    </script>
    <noscript>
      <style>
        html:not(.js) .reveal-line > span,
        html:not(.js) [data-fade],
        html:not(.js) [data-stagger],
        html:not(.js) [data-zoom] {
          transform: none;
          opacity: 1;
          scale: 1;
        }
      </style>
    </noscript>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:bg-ink focus:px-5 focus:py-3 focus:font-mono focus:text-2xs focus:uppercase focus:tracking-micro-wide focus:text-bone"
    >
      Skip to content
    </a>
    <slot />
  </body>
</html>
