---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Cursor from "../components/Cursor.astro";
import Hero from "../components/Hero.astro";
import Marquee from "../components/Marquee.astro";
import Estate from "../components/Estate.astro";
import Manifesto from "../components/Manifesto.astro";
import Land from "../components/Land.astro";
import Wines from "../components/Wines.astro";
import Process from "../components/Process.astro";
import Visit from "../components/Visit.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
---

<BaseLayout>
  <Cursor />
  <Nav />
  <main id="main" tabindex="-1">
    <Hero />
    <Estate />
    <Marquee />
    <Manifesto />
    <Land />
    <Wines />
    <Process />
    <Visit />
  </main>
  <Footer />
</BaseLayout>

<script>
  import Lenis from "lenis";
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import {
    whenMotionAllowed,
    animateLineReveal,
    animateFadeIn,
    animateZoomIn,
    animateStaggerList,
  } from "../utils/animations";

  whenMotionAllowed(() => {
    const lenis = new Lenis({ duration: 1.1 });

    const onScroll = () => ScrollTrigger.update();
    const raf = (time: number) => lenis.raf(time * 1000);
    lenis.on("scroll", onScroll);
    gsap.ticker.add(raf);
    gsap.ticker.lagSmoothing(0);

    const onMenuToggle = (event: Event) => {
      if (!(event instanceof CustomEvent)) return;
      const open = (event.detail as { open?: boolean } | undefined)?.open;
      if (open) lenis.stop();
      else lenis.start();
    };
    document.addEventListener("menu:toggle", onMenuToggle);

    document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) => {
      a.addEventListener("click", (e) => {
        const href = a.getAttribute("href");
        if (!href || href === "#") return;
        const target = document.querySelector<HTMLElement>(href);
        if (target) {
          e.preventDefault();
          lenis.scrollTo(target, { offset: -60, force: true });
        }
      });
    });

    animateLineReveal("#hero");
    animateFadeIn("#hero");

    animateStaggerList("#estate");
    animateZoomIn("#estate");

    animateLineReveal("#manifesto", { duration: 1.2, stagger: 0.12 });
    animateFadeIn("#manifesto");

    animateLineReveal("#land");
    animateStaggerList("#land");
    animateZoomIn("#land");

    animateLineReveal("#wines");
    animateFadeIn("#wines");

    animateLineReveal("#process");
    animateStaggerList("#process", { stagger: 0.12 });

    animateLineReveal("#visit");
    animateZoomIn("#visit");
    animateStaggerList("#visit");
    animateFadeIn("#visit");

    animateLineReveal("#footer", { start: "top 90%" });
    animateFadeIn("#footer", { start: "top 90%", duration: 0.9 });

    return () => {
      document.removeEventListener("menu:toggle", onMenuToggle);
      lenis.off("scroll", onScroll);
      gsap.ticker.remove(raf);
      lenis.destroy();
    };
  });
</script>
