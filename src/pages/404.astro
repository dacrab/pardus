---
import BaseLayout from "../layouts/BaseLayout.astro";
import Cursor from "../components/Cursor.astro";
import "../styles/global.css";
---

<BaseLayout
  title="Page Not Found — PARDUS"
  description="This page has wandered off the western slopes. Return to the PARDUS wine project."
>
  <Cursor />
  <main
    id="main"
    tabindex="-1"
    class="flex min-h-screen flex-col items-center justify-center bg-bone px-6 text-center"
  >
    <p class="label-mono text-ink-soft opacity-60">404 — Lost the trail</p>
    <h1 class="mt-6 font-display text-7xl leading-[0.82] tracking-[-0.06em] md:text-9xl">
      Off the map.
    </h1>
    <p class="mt-6 max-w-md text-balance font-display text-lg leading-[1.15] text-ink">
      This page has wandered off the western slopes.
    </p>
    <a
      href="/"
      class="group mt-10 inline-flex items-center gap-3 bg-ink px-7 py-4 font-mono text-2xs uppercase tracking-micro-wide text-bone transition-colors hover:bg-clay"
    >
      Back to Pardus
      <span class="block h-px w-6 bg-current transition-all group-hover:w-10"></span>
    </a>
  </main>
</BaseLayout>
