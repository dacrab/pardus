---
import Figure from "./Figure.astro";
import SectionHeader from "./SectionHeader.astro";
import { processSteps } from "../data/site";
import pour from "../assets/pour.webp";
---

<section id="process" class="section section--olive">
  <div class="shell">
    <SectionHeader label="The process">
      <h2 class="h2">
        Twelve months, <span class="accent">vine to bottle.</span>
      </h2>
    </SectionHeader>

    <div class="process-grid">
      <ol class="steps">
        {processSteps.map((step, index) => (
          <li class="step" data-reveal>
            <span class="step-num" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <div>
              <div class="step-head">
                <h3 class="step-title">{step.title}</h3>
                <span class="meta step-time">{step.timing}</span>
              </div>
              <p class="step-body">{step.body}</p>
            </div>
          </li>
        ))}
      </ol>

      <Figure
        src={pour}
        alt="Wine being poured into a glass in a dark cellar"
        ratio="portrait"
        caption="Free-run juice, September"
        class="process-figure"
      />
    </div>
  </div>
</section>
