---
import ArrowLink from "./ArrowLink.astro";
import Facts from "./Facts.astro";
import Figure from "./Figure.astro";
import { site, stats } from "../data/site";
import vineyard from "../assets/vineyard.webp";
---

<section id="hero" class="hero">
  <div class="shell">
    <div class="hero-main">
      <div class="hero-copy">
        <h1 class="hero-title">
          par<span>·</span>dus
        </h1>

        <p class="lede hero-lede">
          A natural wine estate on Ano Vouno, a Cycladic island. Hand farmed at {site.altitude} metres, fermented wild
          in clay and concrete, bottled unfined.
        </p>

        <div class="hero-actions">
          <a href="#wines" class="btn">
            Explore the wines
          </a>
          <ArrowLink href="#visit">Book a tasting</ArrowLink>
        </div>
      </div>

      <Figure
        src={vineyard}
        alt="A glass of red wine on a stone ledge above terraced vineyard rows at dusk"
        ratio="portrait"
        caption="Kouloura terraces"
        eager
        class="hero-figure"
      >
        <span slot="meta">{site.altitude} m</span>
      </Figure>
    </div>

    <Facts items={stats} class="hero-stats" />
  </div>
</section>
