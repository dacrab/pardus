---
import RevealLine from "./RevealLine.astro";
---

<section
  id="hero"
  class="relative min-h-screen overflow-hidden bg-bone"
>
  <div class="grid-noise pointer-events-none absolute inset-0 opacity-[0.04]"></div>
  <div
    class="grain pointer-events-none absolute inset-0"
    aria-hidden="true"
  ></div>

  <div class="container-px relative flex min-h-screen flex-col justify-between py-24 md:py-28">
    <div class="flex items-center justify-between label-mono text-ink-soft" data-fade>
      <span>Est. 2019 — Aegean Sea</span>
      <span class="hidden md:block">38.2146° N, 22.1234° E</span>
    </div>

    <div class="flex flex-col items-start">
      <h1
        class="font-display text-7xl leading-[0.82] tracking-[-0.06em] md:text-8xl lg:text-9xl xl:text-[14rem]"
      >
        <RevealLine wrapperClass="px-0.5 pb-1 md:px-1 md:pb-2 lg:px-2">
          par<span class="text-clay">·</span>dus
        </RevealLine>
      </h1>

      <div class="mt-8 grid grid-cols-1 gap-8 md:mt-12 md:grid-cols-12 md:gap-6">
        <p
          class="max-w-md text-balance font-display text-lg leading-[1.15] text-ink md:col-span-5 md:text-xl lg:col-span-4 lg:text-2xl"
          data-fade
        >
          A natural wine project from the western slopes of a forgotten Aegean
          island. <span class="italic">Low intervention, high altitude, single-vineyard.</span>
        </p>

        <div class="flex items-end md:col-span-4 md:col-start-9" data-fade>
          <a
            href="#wines"
            class="group inline-flex items-center gap-3 bg-ink px-7 py-4 font-mono text-2xs uppercase tracking-micro-wide text-bone transition-colors hover:bg-clay"
          >
            Explore the wines
            <span class="block h-px w-6 bg-current transition-all group-hover:w-10"></span>
          </a>
        </div>
      </div>
    </div>

    <div class="flex items-center justify-between" data-fade>
      <span class="font-mono text-3xs uppercase tracking-micro-wide text-ink-soft opacity-60">
        Scroll to pour
      </span>
      <span class="scroll-line"></span>
    </div>
  </div>
</section>
