---
import ArrowLink from "./ArrowLink.astro";
import SectionHeader from "./SectionHeader.astro";
import { wines } from "../data/site";
---

<section id="wines" class="section">
  <div class="shell">
    <SectionHeader label="The wines">
      <div class="section-split">
        <h2 class="h2">
          Four wines, <span class="accent">one harvest each.</span>
        </h2>
        <p class="lede">
          Every parcel is picked, fermented and bottled on its own. Nothing is blended across parcels, and nothing is
          held back for a future release.
        </p>
      </div>
    </SectionHeader>

    <div class="wine-grid">
      {wines.map((wine) => (
        <article class="wine" data-reveal>
          <header class="wine-head">
            <h3 class="wine-name">{wine.name}</h3>
            <span class="meta wine-year">{wine.year}</span>
          </header>

          <p class="wine-varietal">{wine.varietal}</p>
          <p class="wine-notes">{wine.notes}</p>

          <dl class="wine-specs">
            <div>
              <dt class="meta">ABV</dt>
              <dd>{wine.abv}</dd>
            </div>
            <div>
              <dt class="meta">Maceration</dt>
              <dd>{wine.maceration}</dd>
            </div>
            <div>
              <dt class="meta">Production</dt>
              <dd>{wine.production}</dd>
            </div>
          </dl>

          <footer class="wine-foot">
            <span class="wine-price">{wine.price}</span>
            <ArrowLink href="#visit">Enquire</ArrowLink>
          </footer>
        </article>
      ))}
    </div>
  </div>
</section>
