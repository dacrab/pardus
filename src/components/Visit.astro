---
import Facts from "./Facts.astro";
import Figure from "./Figure.astro";
import SectionHeader from "./SectionHeader.astro";
import { site, visitDetails } from "../data/site";
import tasting from "../assets/tasting.webp";
---

<section id="visit" class="section">
  <div class="shell">
    <SectionHeader label="Visit">
      <h2 class="h2">
        Come up the hill. <span class="accent">Stay until the light goes.</span>
      </h2>
    </SectionHeader>

    <div class="split">
      <div class="split-copy">
        <p class="lede">
          Tastings are by appointment, for no more than eight people, on a stone terrace overlooking the village and the
          western sea.
        </p>

        <Facts items={visitDetails} columns={2} variant="rows" class="visit-details" />

        <a href={`mailto:${site.email.visit}`} class="btn">
          Request a tasting
        </a>
      </div>

      <Figure
        src={tasting}
        alt="Four glasses of wine ranged across the head of an oak barrel"
        ratio="landscape"
        caption="The tasting terrace"
        class="split-figure"
      >
        <span slot="meta">{site.altitude} m</span>
      </Figure>
    </div>
  </div>
</section>
