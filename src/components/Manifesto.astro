---
import SectionHeader from "./SectionHeader.astro";
import { neverUsed } from "../data/site";
---

<section id="manifesto" class="section section--paper">
  <div class="shell">
    <SectionHeader label="Manifesto">
      <h2 class="h2">
        We make wine. <span class="accent">We add almost nothing.</span>
      </h2>
    </SectionHeader>

    <div class="split">
      <div class="split-copy">
        <p class="lede">
          No oak chips, no selected yeasts, no enzymes. No acid or sugar corrections, no reverse osmosis, no spinning
          cone. The cellar does the rest: clay, concrete, gravity, time.
        </p>
        <p class="manifesto-sign">M. Halaris, winemaker</p>
      </div>

      <div class="never" data-reveal>
        <p class="meta never-label">Never in the cellar or bottle</p>
        <ul class="never-list">
          {neverUsed.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
