---
import Facts from "./Facts.astro";
import Figure from "./Figure.astro";
import SectionHeader from "./SectionHeader.astro";
import { landFacts, site } from "../data/site";
import land from "../assets/land.webp";
---

<section id="land" class="section section--ink">
  <div class="shell">
    <SectionHeader label="The land">
      <h2 class="h2">
        Six hundred and twelve metres <span class="accent">above the meltemi.</span>
      </h2>
    </SectionHeader>
  </div>

  <Figure
    src={land}
    alt="Sunlit barley cover crop moving in the wind on the upper terraces"
    ratio="wide"
    caption="Cover crop on the upper terraces"
    overlay
    class="land-figure"
  >
    <div class="land-altitude" aria-hidden="true">
      <strong>{site.altitude}</strong>
      <span class="meta">metres</span>
    </div>
    <span slot="meta">
      {site.coordinates.lat} · {site.coordinates.lng}
    </span>
  </Figure>

  <div class="shell">
    <Facts items={landFacts} class="land-facts" />
  </div>
</section>
