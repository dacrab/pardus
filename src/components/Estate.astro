---
import Facts from "./Facts.astro";
import Figure from "./Figure.astro";
import SectionHeader from "./SectionHeader.astro";
import { estateFacts } from "../data/site";
import estate from "../assets/estate.webp";
---

<section id="estate" class="section">
  <div class="shell">
    <SectionHeader label="Estate">
      <h2 class="h2">A small estate with a long memory.</h2>
    </SectionHeader>

    <div class="split">
      <div class="split-copy">
        <p class="lede">
          Pardus is 3.2 hectares of terraced vines on the western slope of Ano Vouno. The oldest parcels were planted
          around 1958.
        </p>
        <p>
          We harvest in small crates and sort at the vine. The wine ferments on native yeast in old clay and concrete,
          then rests on its lees until it is ready. Nothing is added that the wine does not need.
        </p>
      </div>

      <Figure
        src={estate}
        alt="A glass of red wine with a bunch of grapes and vine leaves on a dark table"
        ratio="square"
        caption="Mavrotragano, old vines"
        class="split-figure"
      />
    </div>

    <Facts items={estateFacts} columns={3} variant="rows" class="estate-facts" />
  </div>
</section>
