---
interface Props {
  id: string;
  as?: "section" | "footer";
  tone?: "bone" | "ink" | "clay";
  padding?: string;
}
const { id, as: Tag = "section", tone = "bone", padding = "py-16 md:py-32 lg:py-48" } =
  Astro.props as Props;
const toneClass = {
  bone: "bg-bone",
  ink: "bg-ink text-bone",
  clay: "bg-clay-deep text-bone",
}[tone];
---

<Tag id={id} class={`relative ${toneClass} ${padding}`}>
  <div class="container-px">
    <slot />
  </div>
</Tag>
