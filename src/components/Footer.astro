---
import ArrowLink from "./ArrowLink.astro";
import { nav, site } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell">
    <div class="footer-top">
      <div class="footer-lead">
        <h2 class="footer-title">
          A letter, <em>twice a year,</em> no more.
        </h2>
        <ArrowLink href={`mailto:${site.email.hello}?subject=Subscribe`}>Join the letter</ArrowLink>
      </div>

      <nav class="footer-cols" aria-label="Footer">
        <div>
          <p class="meta">Index</p>
          <ul>
            {nav.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <p class="meta">Contact</p>
          <ul>
            <li>
              <a href={`mailto:${site.email.hello}`}>{site.email.hello}</a>
            </li>
            <li>
              <a href={`mailto:${site.email.visit}`}>{site.email.visit}</a>
            </li>
          </ul>
        </div>
      </nav>
    </div>

    <p class="meta footer-bottom">
      <span>
        © {year} {site.name} Wine Project
      </span>
      <span>{site.address.display}</span>
      <span>
        {site.coordinates.lat} · {site.coordinates.lng}
      </span>
    </p>

    <svg class="footer-word" viewBox="0 0 1200 330" aria-hidden="true" focusable="false">
      <text x="600" y="290" text-anchor="middle" textLength="1200" lengthAdjust="spacingAndGlyphs">
        pardus
      </text>
    </svg>
  </div>
</footer>
