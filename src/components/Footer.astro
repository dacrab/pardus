---
import Section from "./Section.astro";
import SectionHeading from "./SectionHeading.astro";
import RevealLine from "./RevealLine.astro";

const year = new Date().getFullYear();
---

<Section id="footer" as="footer" tone="ink" padding="py-12 md:py-24 lg:py-32">
  <SectionHeading number="06" label="Stay in touch" tone="muted">
    <h2
      class="mt-4 font-display text-4xl leading-[0.9] tracking-[-0.05em] md:mt-6 md:text-6xl lg:text-8xl"
    >
      <RevealLine>A letter,</RevealLine>
      <RevealLine class="italic text-clay">twice a year,</RevealLine>
      <RevealLine>no more.</RevealLine>
    </h2>
  </SectionHeading>

  <div class="mt-8 grid grid-cols-12 gap-6 md:mt-12">
    <div class="col-span-12 md:col-span-7">
      <form
        class="flex max-w-xl flex-col gap-3 border-b border-bone/30 pb-4 md:flex-row md:items-center"
        data-fade
      >
        <input
          type="email"
          placeholder="your@email"
          aria-label="Email address for newsletter"
          class="w-full flex-1 bg-transparent py-3 font-mono text-base text-bone placeholder:opacity-30 focus:outline-none"
          required
        />
        <button
          type="submit"
          class="group flex items-center gap-2 self-start font-mono text-2xs uppercase tracking-micro-wide text-bone md:self-auto"
        >
          Subscribe
          <span class="block h-px w-8 bg-current transition-all group-hover:w-14"></span>
        </button>
      </form>
      <p class="mt-4 font-mono text-3xs uppercase tracking-micro opacity-40">
        Vintage reports · allocation notices · cellar-door news. Unsubscribe anytime.
      </p>
    </div>

    <div class="col-span-6 md:col-span-2 md:col-start-9">
      <p class="label-mono opacity-50">Cellar</p>
      <ul class="mt-6 space-y-3 font-display text-lg">
        <li><a href="#wines" class="hover:text-clay">Wines</a></li>
        <li><a href="#process" class="hover:text-clay">Process</a></li>
        <li><a href="#visit" class="hover:text-clay">Visit</a></li>
      </ul>
    </div>
    <div class="col-span-6 md:col-span-2">
      <p class="label-mono opacity-50">Channels</p>
      <ul class="mt-6 space-y-3 font-display text-lg">
        <li><a href="#" class="hover:text-clay">Instagram</a></li>
        <li><a href="#" class="hover:text-clay">Substack</a></li>
        <li><a href="mailto:hello@pardus.wine" class="hover:text-clay">Email</a></li>
      </ul>
    </div>
  </div>

  <div class="mt-16 flex flex-col items-start justify-between gap-6 border-t border-bone/15 pt-8 label-mono opacity-50 md:mt-24 lg:mt-32 md:flex-row md:items-center">
    <div>© {year} Pardus Wine Project · All vintages bottled unfined & unfiltered</div>
    <div class="flex items-center gap-6">
      <span>38.2146° N</span>
      <span class="opacity-30">·</span>
      <span>22.1234° E</span>
      <span class="opacity-30">·</span>
      <span>612m</span>
    </div>
  </div>

  <div class="mt-10 overflow-hidden md:mt-16 lg:mt-20">
    <div
      class="font-display text-7xl leading-[0.8] tracking-[-0.07em] text-bone/[0.08] md:text-8xl lg:text-9xl xl:text-[14rem]"
      aria-hidden="true"
    >
      par·dus
    </div>
  </div>
</Section>
